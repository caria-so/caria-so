    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Office">
      <rdfs:label>Office</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#OnlineLearning">
      <rdfs:label>Online Learning</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Sports">
      <rdfs:label>Sports</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#TakeoutAndFoodDelivery">
      <rdfs:label>Takeout and Food Delivery</rdfs:label>
