    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#B2BMedicalAndPharma">
      <rdfs:label>B2B Medical and Pharma</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Banking">
      <rdfs:label>Banking</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#DigitalSubscriptionsAndSaaS">
      <rdfs:label>Digital Subscriptions and SaaS</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Electronics">
      <rdfs:label>Electronics</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Furniture">
      <rdfs:label>Furniture</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Groceries">
      <rdfs:label>Groceries</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#HealthAndBeauty">
      <rdfs:label>Health and Beauty</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Hobbies">
      <rdfs:label>Hobbies</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#HomeDecor">
      <rdfs:label>Home Decor</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#HomeImprovementAndHardware">
      <rdfs:label>Home Improvement and Hardware</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Insurance">
      <rdfs:label>Insurance</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#MassMerchant">
      <rdfs:label>Mass Merchant</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#MealKitSubscriptions">
