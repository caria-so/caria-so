<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://flowws.io/UXontology.owl"
         xmlns="http://flowws.io/UXontology.owl#">

<owl:Ontology rdf:about="http://flowws.io/UXontology.owl"/>


<!-- 
///////////////////////////////////////////////////////////////////////////////////////
//
// Annotation Properties
//
///////////////////////////////////////////////////////////////////////////////////////
-->
<owl:AnnotationProperty rdf:about="#database_id">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unique identifier for an entity in the database.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#platform">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The platform or system where the entity is applicable (e.g., web, mobile).</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#importance_score">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A numerical score representing the importance or priority of the entity.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#severity_weight">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight indicating the severity or impact of an issue associated with the entity.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#frequency_weight">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight indicating how frequently the issue or behavior occurs.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#estimated_cost">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Estimated cost associated with addressing the issue or implementing the entity.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#issue">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Description of the issue or problem associated with the entity.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#advice">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recommended action or advice to resolve the issue or improve the entity.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#author">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The author or creator of the entity or related content.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#source">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The source or origin of the data associated with the entity.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#created_date">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The date when the entity or issue was created.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#updated_date">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The date when the entity or issue was last updated.</rdfs:comment>
</owl:AnnotationProperty>


<!-- 
///////////////////////////////////////////////////////////////////////////////////////
//
// Object Properties
//
///////////////////////////////////////////////////////////////////////////////////////
-->
<owl:ObjectProperty rdf:about="#foundOnPage">
  <rdfs:domain rdf:resource="#UIComponent"/>
  <rdfs:range rdf:resource="#PageType"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Indicates the page type on which a UI component is found.
  </rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasIssue">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class rdf:about="#UserAction"/>
        <owl:Class rdf:about="#Outcome"/>
        <owl:Class rdf:about="#SystemBehavior"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#Issue"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Indicates that a user action, outcome, or system behavior is associated with a specific UX issue.
  </rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isCausedBy">
  <rdfs:domain rdf:resource="#Outcome"/>
  <rdfs:range rdf:resource="#Cause"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Links outcomes or effects to their underlying causes.
  </rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#impacts">
  <rdfs:domain rdf:resource="#Cause"/>
  <rdfs:range rdf:resource="#Effect"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Describes how a cause or issue affects business or user outcomes.
  </rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#solves">
  <rdfs:domain rdf:resource="#Solution"/>
  <rdfs:range rdf:resource="#Issue"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Indicates that a solution resolves a specific UX issue.
  </rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requires">
  <rdfs:domain rdf:resource="#Solution"/>
  <rdfs:range rdf:resource="#Requirement"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Describes dependencies or requirements for implementing a solution.
  </rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#implements">
  <rdfs:domain rdf:resource="#Solution"/>
  <rdfs:range rdf:resource="#ImplementationDetail"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Links a solution to its implementation details or supporting elements.
  </rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isRelevantToIndustry">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class rdf:about="#UIComponent"/>
        <owl:Class rdf:about="#PageType"/>
        <owl:Class rdf:about="#UXGuideline"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#IndustryType"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Indicates the industry or industries relevant to this entity.
  </rdfs:comment>
</owl:ObjectProperty>



<!-- 
///////////////////////////////////////////////////////////////////////////////////////
//
// Classes
//
///////////////////////////////////////////////////////////////////////////////////////
-->
<owl:Class rdf:about="#UIComponent">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Represents a user interface component, such as buttons, links, images, or other elements visible on a page.
  </rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PageType">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Represents a type of page in a system, such as a homepage, product page, or checkout page.
  </rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#UXGuideline">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Represents a UX design guideline or pattern.
  </rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#UserAction">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    User behaviors and interactions with the interface to achieve specific goals.
  </rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Outcome">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Direct system responses and interface behaviors resulting from user actions.
  </rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Cause">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Underlying technical, design, or UX issues that create problems.
  </rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Effect">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Business and user impacts resulting from UX issues.
  </rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Solution">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Approaches and implementations to address identified UX issues.
  </rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Issue">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Specific problems or issues observed in the UX process that need to be resolved.
  </rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndustryType">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Represents different industries, such as E-Commerce, Healthcare, and more.
  </rdfs:comment>
  <owl:oneOf rdf:parseType="Collection">
    <owl:NamedIndividual rdf:about="#AllIndustries">
      <rdfs:label>All Industries</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#ApparelAndAccessories">
      <rdfs:label>Apparel and Accessories</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Automotive">
      <rdfs:label>Automotive</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#B2BComponentsAndMachinery">
